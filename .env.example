# Copy this file to ".env.local" and fill in the values.
# ".env.local" is never uploaded to GitHub.
#
# Where to find them in Supabase:
#   Project URL        -> the "Connect" button, or Project Settings -> Data API
#   Publishable key    -> Project Settings -> API Keys (starts with sb_publishable_)
#
# NEVER put a "secret" / "service_role" key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
